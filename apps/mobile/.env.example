# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Supabase project URL and PUBLISHABLE key (safe to expose in client code —
# this is not the secret key). Find both in Supabase dashboard > Settings > API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Monzo OAuth client ID (public — the client secret lives only in Supabase's
# edge function secrets, never in the mobile app). Register a client at
# https://developers.monzo.com/.
EXPO_PUBLIC_MONZO_CLIENT_ID=
