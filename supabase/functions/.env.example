# Edge function secrets — set these with `supabase secrets set --env-file .env`
# (after copying this to .env; that .env is gitignored, never commit it).
# SUPABASE_URL and SUPABASE_SECRET_KEYS are provided automatically by Supabase
# for every hosted Edge Function and don't need to be set here.

# Monzo OAuth client credentials (exchange-token, fetch-transactions).
# Register a client at https://developers.monzo.com/.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=

# OpenAI API key (ask-cait, categorise-transactions, categorise-backlog).
OPENAI_API_KEY=
